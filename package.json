{
  "name": "ng-orbit-monorepo",
  "private": true,
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "nx": "NX_DAEMON=false NX_ISOLATE_PLUGINS=false nx",
    "demo": "concurrently -c auto -n core,material,daisy \"pnpm demo:core\" \"pnpm demo:material\" \"pnpm demo:daisy\"",
    "demo:docker": "concurrently -c auto -n core,material,daisy \"pnpm demo:core:docker\" \"pnpm demo:material:docker\" \"pnpm demo:daisy:docker\"",
    "demo:stop": "node scripts/demo-stop-ports.mjs",
    "demo:restart": "pnpm demo:stop && pnpm demo",
    "demo:core": "node scripts/serve-demo.mjs demo-core 4200",
    "demo:core:docker": "node scripts/serve-demo.mjs demo-core 4200 0.0.0.0",
    "demo:material": "node scripts/serve-demo.mjs demo-material 4201",
    "demo:material:docker": "node scripts/serve-demo.mjs demo-material 4201 0.0.0.0",
    "demo:daisy": "node scripts/serve-demo.mjs demo-daisy 4202",
    "demo:daisy:docker": "node scripts/serve-demo.mjs demo-daisy 4202 0.0.0.0",
    "build": "pnpm nx run-many -t build",
    "test": "pnpm nx run-many -t test",
    "lint": "pnpm nx run-many -t lint",
    "format": "pnpm nx format:write",
    "release:smoke": "node scripts/release-smoke.mjs"
  },
  "dependencies": {
    "@angular/animations": "21.2.1",
    "@angular/cdk": "21.2.1",
    "@angular/common": "21.2.1",
    "@angular/compiler": "21.2.1",
    "@angular/core": "21.2.1",
    "@angular/forms": "21.2.1",
    "@angular/material": "21.2.1",
    "@angular-architects/native-federation": "21.2.1",
    "@angular/platform-browser": "21.2.1",
    "@angular/platform-server": "21.2.1",
    "@angular/ssr": "21.2.1",
    "@angular/router": "21.2.1",
    "@ngx-translate/core": "^17.0.0",
    "@ngx-translate/http-loader": "^17.0.0",
    "prismjs": "^1.29.0",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@nx/js": "20.8.4",
    "@angular/build": "21.2.1",
    "@angular/cli": "21.2.1",
    "@angular/compiler-cli": "21.2.1",
    "@types/prismjs": "^1.26.5",
    "@types/node": "^22.18.1",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.2.1",
    "daisyui": "^4.12.24",
    "jsdom": "^28.0.0",
    "ng-packagr": "21.2.0",
    "nx": "^20.0.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
