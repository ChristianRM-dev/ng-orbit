{
  "name": "@ng-orbit/wizard-render-material",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "root": "packages/wizard-render-material",
  "sourceRoot": "packages/wizard-render-material/src",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p packages/wizard-render-material/tsconfig.lib.json"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p packages/wizard-render-material/tsconfig.spec.json --noEmit"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p packages/wizard-render-material/tsconfig.lib.json --noEmit"
      }
    }
  }
}
