{
  "name": "alerts",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "root": "packages/notify",
  "sourceRoot": "packages/notify/src",
  "targets": {
    "build": {
      "executor": "@angular/build:ng-packagr",
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "{workspaceRoot}/dist/packages/notify"
      ],
      "options": {
        "project": "packages/notify/ng-package.json",
        "tsConfig": "packages/notify/tsconfig.lib.json"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p packages/notify/tsconfig.spec.json --noEmit"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p packages/notify/tsconfig.lib.json --noEmit"
      }
    }
  }
}
